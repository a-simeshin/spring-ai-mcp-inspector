{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "types": [
      "vite/client",
      "node"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@inspector/core/*": [
        "./core/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime"
      ],
      "react-syntax-highlighter/dist/esm/prism-light": [
        "./src/types/react-syntax-highlighter-prism-light"
      ],
      "react-syntax-highlighter/dist/esm/styles/prism/tomorrow": [
        "./src/types/react-syntax-highlighter-style"
      ],
      "react-syntax-highlighter/dist/esm/languages/prism/*": [
        "./src/types/react-syntax-highlighter-grammar"
      ]
    }
  },
  "include": [
    "src",
    "core/**/*.ts"
  ],
  "exclude": [
    "src/**/*.stories.tsx",
    "src/**/*.stories.ts",
    "src/**/*.test.tsx",
    "src/**/*.test.ts",
    "src/test/**",
    "core/**/*.test.ts",
    "core/**/*.test.tsx",
    "core/**/__tests__/**"
  ]
}